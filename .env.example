# Frontend Environment Variables

# API Configuration
VITE_API_BASE_URL=http://localhost:5000/api

# Firebase Web SDK (required for realtime messaging and browser notifications)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Environment (auto | dev | staging | production)
VITE_APP_ENV=auto

# Paystack environment is controlled on the backend only: test or live

# Analytics (optional)
VITE_ANALYTICS_ID=

# Feature Flags
VITE_ENABLE_DEBUG=false

# Client-side caching (sessionStorage) - set to false to disable caching in browser
# TTL values are in seconds. DEFAULT is used when individual calls omit a TTL.
# VITE_CACHE_ENABLED: true/false
# VITE_CACHE_TTL_DEFAULT: default TTL in seconds (e.g. 60)
# VITE_CACHE_TTL_MAX: maximum TTL allowed (safety cap)
VITE_CACHE_ENABLED=true
VITE_CACHE_TTL_DEFAULT=60
VITE_CACHE_TTL_MAX=3600
