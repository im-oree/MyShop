# Backend Environment Variables

# Server
NODE_ENV=development
APP_ENV=auto
PORT=5000

# Firebase Admin SDK
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY=your-private-key
FIREBASE_CLIENT_EMAIL=your-client-email

# JWT
JWT_SECRET=your-jwt-secret-key-change-in-production
JWT_EXPIRY=7d

# Email (Brevo - completely free tier)
# Get free API key from: https://www.brevo.com/
# Free tier: 300 emails/day forever
BREVO_API_KEY=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
SENDER_EMAIL=noreply@eShop.com
SENDER_NAME=eShop

# Payment Providers
# Paystack environment only: test or live
PAYSTACK_ENV=test
PAYSTACK_TEST_SECRET_KEY=your-paystack-test-secret-key
PAYSTACK_TEST_PUBLIC_KEY=your-paystack-test-public-key
PAYSTACK_LIVE_SECRET_KEY=your-paystack-live-secret-key
PAYSTACK_LIVE_PUBLIC_KEY=your-paystack-live-public-key

# Optional Providers (Future)
STRIPE_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=

# CORS
CORS_ORIGIN=http://localhost:5173

# Features
ENABLE_STRIPE=false
ENABLE_FLUTTERWAVE=false
